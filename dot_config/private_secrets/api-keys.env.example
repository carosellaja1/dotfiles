# API keys used by the templated IDE configs (~/.cursor/mcp.json, ~/.config/zed/settings.json).
#
# Setup on each machine:
#   cp ~/.config/secrets/api-keys.env.example ~/.config/secrets/api-keys.env
#   chmod 600 ~/.config/secrets/api-keys.env
#   $EDITOR ~/.config/secrets/api-keys.env      # fill in what you use, delete the rest
#   exec zsh && chezmoi apply                   # .zshrc sources this file, then templates read it
#
# The real api-keys.env is listed in .chezmoiignore and the repo's .gitignore,
# so it is never synced. Only this example file is.

export BRAVE_API_KEY=""
export CONTEXT7_API_KEY=""
export FIGMA_API_KEY=""
export GOOGLE_MAPS_API_KEY=""
export GRAPHLIT_ENVIRONMENT_ID=""
export GRAPHLIT_JWT_SECRET=""
export GRAPHLIT_ORGANIZATION_ID=""
export HYPERBROWSER_API_KEY=""
export LINEAR_API_KEY=""
export MAGIC_21ST_API_KEY=""
export MAPBOX_ACCESS_TOKEN=""
export PERPLEXITY_API_KEY=""
export SUPABASE_ACCESS_TOKEN=""
export TAVILY_API_KEY=""
