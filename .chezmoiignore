# .chezmoiignore is a Go template. Patterns listed here are NOT written to $HOME.

# Repo-only files
README.md
LICENSE
docs/

# ---------------------------------------------------------------------------
# Secrets and per-machine state. These must never be managed by chezmoi, even
# if `chezmoi add` is run on their parent directory by mistake.
# ---------------------------------------------------------------------------
.config/secrets/api-keys.env
.config/gh/hosts.yml
.config/raycast/config.json
.config/raycast/ai/providers.yaml
.claude/.credentials.json

# IDE / agent state (not settings)
.cursor/extensions/
.cursor/projects/
.cursor/worktrees/
.cursor/ai-tracking/
.cursor/ide_state.json
.cursor/argv.json
.claude/history.jsonl
.claude/stats-cache.json
.claude/debug/
.claude/file-history/
.claude/plans/
.claude/plugins/
.claude/projects/
.claude/session-env/
.claude/shell-snapshots/
.claude/statsig/
.claude/telemetry/
.claude/todos/
.claude/ide/
.claude/downloads/
.claude/chrome/
.claude/agents/
.claude/settings.local.json
.serena/language_servers/

# Local backups made by run_before_ide-backup.sh
.config/ide/vscode/backup/

# Zsh plugins are cloned at runtime by ~/.zsh/plugin-loader.zsh
.zsh/plugins/

# Common junk
.DS_Store
*.swp
*.swo
*~
*.zwc
*.zwc.old

{{ if ne .chezmoi.os "darwin" -}}
# ---------------------------------------------------------------------------
# macOS-only entries, skipped on {{ .chezmoi.os }}
# ---------------------------------------------------------------------------
.config/iterm2
.config/raycast
.zprofile
Library
{{ else -}}
# Linux-only IDE paths, skipped on macOS (which uses ~/Library/Application Support)
.config/Code
.config/Cursor
{{ end -}}
